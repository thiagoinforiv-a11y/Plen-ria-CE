# Token do bot, obtido com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui

# Tamanho máximo (MB) de vídeo que o bot tenta enviar (limite padrão do Telegram é 50MB)
MAX_FILE_SIZE_MB=50

# Pasta onde os vídeos são baixados temporariamente
DOWNLOAD_DIR=downloads

# (Opcional) Caminho para um arquivo de cookies no formato Netscape,
# útil quando o Instagram/Facebook exige login para acessar o conteúdo.
# COOKIES_FILE=cookies.txt
